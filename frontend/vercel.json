{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://u-craft-backend.onrender.com/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://u-craft-backend.onrender.com/api/$1"
    },
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|favicon\\.svg|og-image\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}